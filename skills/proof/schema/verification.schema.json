{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification.json",
  "description": "A recipient's verification of one received proof.json, produced by the recipient's own copy of the skill. Bound to the exact bytes received by proof_sha256. Every mechanical result is recomputed at finalize; only the claim audits come from the recipient's agent. A person makes the decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_version",
    "proof_sha256",
    "verified_at",
    "verified_by",
    "environment",
    "remote",
    "head_ref",
    "head_on_default_branch",
    "outcome",
    "reason",
    "problems",
    "counts",
    "identity",
    "signals",
    "evidence",
    "claims",
    "notes"
  ],
  "properties": {
    "verification_version": {
      "type": "string",
      "pattern": "^0\\.3\\.[0-9]+$",
      "default": "0.3.0"
    },
    "proof_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the exact proof.json bytes the recipient received."
    },
    "verified_at": { "type": "string", "format": "date-time" },
    "verified_by": { "type": ["string", "null"], "maxLength": 120 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "git", "node"],
      "properties": {
        "tool": { "type": "string", "description": "proof-skill/<version> of the recipient's copy." },
        "git": { "type": "string" },
        "node": { "type": "string" }
      }
    },
    "remote": {
      "type": ["string", "null"],
      "description": "Exactly the URL that was fetched (https, no credentials), or null when nothing was fetched."
    },
    "head_ref": {
      "type": ["string", "null"],
      "description": "The fetched branch or tag that contains head_sha, e.g. refs/heads/main; null when none does."
    },
    "head_on_default_branch": { "type": ["boolean", "null"] },
    "outcome": {
      "enum": ["reproduced", "contradicted", "inconclusive", "not_reproducible"],
      "description": "reproduced: every mechanical check passed against the public repository. contradicted: something in the evidence register is false. inconclusive: the check could not complete, or a recount differs only where the two git versions differ. not_reproducible: no public repository could be checked; most professional work is private, so this is neutral."
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_total",
        "evidence_failed",
        "numbers_rederived",
        "numbers_self_reported",
        "numbers_unbacked"
      ],
      "properties": {
        "evidence_total": { "type": "integer", "minimum": 0 },
        "evidence_failed": { "type": "integer", "minimum": 0 },
        "numbers_rederived": { "type": "integer", "minimum": 0 },
        "numbers_self_reported": { "type": "integer", "minimum": 0 },
        "numbers_unbacked": { "type": "integer", "minimum": 0 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "account", "signature", "emails"],
      "properties": {
        "status": {
          "enum": ["bound", "unbound", "conflict"],
          "description": "bound: a valid signature by a key on the account, and every identity email belongs to the account. unbound: no signature, or an email could not be bound. conflict: a bad signature, or an email belongs to another account."
        },
        "account": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["host", "login"],
          "properties": {
            "host": { "type": "string" },
            "login": { "type": "string" }
          }
        },
        "signature": { "enum": ["valid", "invalid", "absent"] },
        "emails": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["email", "status", "method"],
            "properties": {
              "email": { "type": "string" },
              "status": { "enum": ["bound", "unbound", "conflict"] },
              "method": { "enum": ["noreply", "api", "unknown"] }
            }
          }
        }
      }
    },
    "signals": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "default_branch",
        "solo_repository",
        "total_authors",
        "cited_commits",
        "on_default_branch",
        "committed_by_subject",
        "committed_by_forge",
        "committed_by_other"
      ],
      "description": "Unauthenticated signals: whoever controls the repository controls them. Null when nothing was fetched.",
      "properties": {
        "default_branch": { "type": ["string", "null"] },
        "solo_repository": { "type": "boolean" },
        "total_authors": { "type": "integer", "minimum": 0 },
        "cited_commits": { "type": "integer", "minimum": 0 },
        "on_default_branch": { "type": "integer", "minimum": 0 },
        "committed_by_subject": { "type": "integer", "minimum": 0 },
        "committed_by_forge": { "type": "integer", "minimum": 0 },
        "committed_by_other": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "problems", "numbers", "ownership"],
        "properties": {
          "id": { "type": "string", "pattern": "^e[0-9]+$" },
          "status": { "enum": ["ok", "failed", "unchecked"] },
          "problems": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["raw", "class", "source"],
              "properties": {
                "raw": { "type": "string", "minLength": 1 },
                "class": { "enum": ["rederived", "self_reported", "unbacked"] },
                "source": {
                  "type": ["string", "null"],
                  "description": "Where the number came from, in words: a measure label, 'commit subject: <snippet>', or a diff stat. Null when unbacked."
                }
              }
            }
          },
          "ownership": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["blame_share", "subject_commits", "total_commits", "other_identities"],
            "properties": {
              "blame_share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "subject_commits": { "type": "integer", "minimum": 0 },
              "total_commits": { "type": "integer", "minimum": 0 },
              "other_identities": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "problems", "flags", "audit"],
        "properties": {
          "id": { "type": "string", "pattern": "^c[0-9]+$" },
          "problems": {
            "type": "array",
            "description": "Mechanical problems (a number absent from the cited evidence, a count word). A claim with any problem is unsupported whatever the audit says.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          },
          "flags": {
            "type": "array",
            "description": "Advisory flags for the reader: exclusivity words the ownership facts do not back, words git cannot check, text addressed to a reviewer or an AI.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          },
          "audit": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["verdict", "reason", "question", "pointers"],
            "properties": {
              "verdict": { "enum": ["supported", "partial", "unsupported", "not_assessable"] },
              "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
              "question": { "type": "string", "minLength": 1, "maxLength": 400 },
              "pointers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 },
                "description": "Entries in the audit pack the verdict rests on, e.g. proof:c1, proof:e3, commit:<sha>, file:<path>."
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
